msgid "Enter a number from −1000 to 1000 mm."
msgstr "−1000〜1000 mmの数値を入力してください。"

#: resources/i18n.php:94
msgid "Enter a number from 0.1 to 1000 mm."
msgstr "0.1〜1000 mmの数値を入力してください。"

#: resources/i18n.php:95
msgid "Check the highlighted placement fields."
msgstr "エラーが表示されている配置項目を確認してください。"

