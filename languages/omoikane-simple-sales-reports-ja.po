#: omoikane-simple-sales-reports.php:10
msgid "https://github.com/omoikane-works"
msgstr "https://github.com/omoikane-works"

#. translators: 1: required PHP version, 2: current PHP version.
#: omoikane-simple-sales-reports.php:67
#, php-format
msgid "Omoikane Simple Sales Reports for Welcart requires PHP version %1$s or later. Your current PHP version is %2$s."
msgstr "かんたん売上報告書 for Welcart を利用するには PHP %1$s 以上が必要です。現在の PHP バージョンは、%2$s です。"

#. translators: %s: required Welcart version.
#: omoikane-simple-sales-reports.php:84
#, php-format
msgid "Omoikane Simple Sales Reports for Welcart requires Welcart %s or later."
msgstr "かんたん売上報告書 for Welcart を利用するには Welcart %s 以上が必要です。"

