#. Plugin Name of the plugin
#: omoikane-simple-sales-reports.php:3
msgid "Omoikane Simple Sales Reports for Welcart"
msgstr "かんたん売上報告書 for Welcart"

#. Plugin URI of the plugin
#: omoikane-simple-sales-reports.php:4
msgid "https://github.com/omoikane-works/omoikane-simple-sales-reports"
msgstr "https://github.com/omoikane-works/omoikane-simple-sales-reports"

#. Description of the plugin
#: omoikane-simple-sales-reports.php:5
msgid "Create simple sales reports for Welcart stores."
msgstr "Welcart の売上報告書をかんたんに作成できるプラグインです。"

#. Author of the plugin
#: omoikane-simple-sales-reports.php:9
msgid "Omoikane Works"
msgstr "オモイカネ ワークス"

#. Author URI of the plugin
#: omoikane-simple-sales-reports.php:10
msgid "https://github.com/omoikane-works"
msgstr "https://github.com/omoikane-works"

#. translators: 1: required PHP version, 2: current PHP version.
#: omoikane-simple-sales-reports.php:67
#, php-format
msgid "Omoikane Simple Sales Reports for Welcart requires PHP version %1$s or later. Your current PHP version is %2$s."
msgstr "かんたん売上報告書 for Welcart を利用するには PHP %1$s 以上が必要です。現在の PHP バージョンは、%2$s です。"

#. translators: %s: required Welcart version.
#: omoikane-simple-sales-reports.php:84
#, php-format
msgid "Omoikane Simple Sales Reports for Welcart requires Welcart %s or later."
msgstr "かんたん売上報告書 for Welcart を利用するには Welcart %s 以上が必要です。"

#: omoikane-simple-sales-reports.php:104
msgid "Plugin activation failed."
msgstr "プラグインの有効化に失敗しました。"

#: omoikane-simple-sales-reports.php:143
msgid "Required libraries for Omoikane Simple Sales Reports for Welcart were not found. Please run composer install."
msgstr "かんたん売上報告書 for Welcart の依存ライブラリが見つかりません。composer install を実行してください。"

